# Local development only. Supply independent random hexadecimal passwords.
GOSTACK_ENV=development
GOSTACK_LOG_LEVEL=info
GOSTACK_HTTP_ADDRESS=127.0.0.1:8080
GOSTACK_MIGRATION_DIRECTORY=migrations
POSTGRES_PASSWORD=
GOSTACK_MIGRATOR_PASSWORD=
GOSTACK_RUNTIME_PASSWORD=
# Native commands additionally require explicit connection URLs:
# GOSTACK_DATABASE_URL=postgres://gostack_runtime:<URL-encoded-password>@127.0.0.1:5432/gostack?sslmode=disable
# GOSTACK_MIGRATION_DATABASE_URL=postgres://gostack_migrator:<URL-encoded-password>@127.0.0.1:5432/gostack?sslmode=disable
# Production requires GOSTACK_ENV=production and sslmode=verify-full.
